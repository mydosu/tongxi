<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的底板：与 brand.svg 里 tile 的渐变一致（315° 左上到右下），不画描边。
     前景是 build_android_icon.py 出的透明菱形图，底板只负责这层颜色。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#fdfcff"
        android:centerColor="#f1effb"
        android:endColor="#e3eefa" />
</shape>
