{
  "name": "tongxi-mobile",
  "private": true,
  "version": "3.8.25",
  "type": "module",
  "description": "同席手机薄壳：粘贴访问地址后整页打开桌面同席的网关地址",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:init": "tauri android init --ci",
    "android:apk": "pwsh -NoProfile -File scripts/android-build.ps1 -Target aarch64",
    "android:apk:x86_64": "pwsh -NoProfile -File scripts/android-build.ps1 -Target x86_64",
    "android:apk:release": "pwsh -NoProfile -File scripts/android-build.ps1 -Release -Target aarch64"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
